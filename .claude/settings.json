{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-report.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(../skypermit/**)",
      "Write(../skypermit/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
